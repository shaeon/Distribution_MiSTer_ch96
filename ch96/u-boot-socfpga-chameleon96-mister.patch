diff --git a/board/novtech/chameleon96/board.c b/board/novtech/chameleon96/board.c
index 3101af16..03ce903c 100644
--- a/board/novtech/chameleon96/board.c
+++ b/board/novtech/chameleon96/board.c
@@ -153,3 +153,20 @@ int board_late_init(void) {
 }
 
 #endif /* CONFIG_BOARD_LATE_INIT */
+
+#include <init.h>
+#include <asm/global_data.h>
+
+/*
+ * MiSTer layout: only the lower 256MB belong to the HPS. The upper 256MB
+ * (0x10000000-0x1FFFFFFF) hold the core DDR windows, the scaler framebuffer
+ * and, at 0x1FFFF000, the page where Main_MiSTer leaves the core to load
+ * after a warm reboot. Keep the relocated U-Boot (and its 64MB malloc area)
+ * below 0x10000000 so it does not overwrite that page before "fpgacheck"
+ * reads it. On the DE10-nano (1GB) U-Boot relocates above 0x20000000, so
+ * the problem does not exist there.
+ */
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	return 0x10000000;
+}
